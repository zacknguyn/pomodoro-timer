# PostgreSQL connection string (RDS)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://pomogit:change-me@127.0.0.1:5432/pomogit

# Set to 'false' only for local dev without SSL
DATABASE_SSL=false
# Production only when the database CA is not already trusted by Node.
# Keep the PEM in your secret manager and preserve newlines as \\n.
DATABASE_CA_CERT=

# Opaque login sessions are stored server-side in PostgreSQL. No JWT secret is required.
# Set to production to enable the Secure __Host- cookie.
NODE_ENV=development

# Session lifetime in hours (default: 168 / 7 days)
SESSION_TTL_HOURS=168

# Local UI work only. Ignored when NODE_ENV=production.
DEV_BYPASS_AUTH=false

# Frontend URL for CORS (CloudFront domain or localhost)
FRONTEND_URL=http://localhost:5173

# Local dev only
PORT=3000
