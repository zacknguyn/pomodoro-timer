# Local PostgreSQL connection. Replace change-me in both values below.
POSTGRES_PASSWORD=change-me
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://pomogit:change-me@127.0.0.1:5432/pomogit

# Set to 'false' only for local dev without SSL
DATABASE_SSL=false
# Production only when the database CA is not already trusted by Node.
# Keep the PEM in your secret manager and preserve newlines as \\n.
DATABASE_CA_CERT=

# Opaque login sessions are stored server-side in PostgreSQL. No JWT secret is required.
# Set to production to enable the Secure __Host- cookie.
NODE_ENV=development

# Session lifetime in hours (default: 168 / 7 days)
SESSION_TTL_HOURS=168

# Optional GitHub login: server-side OAuth App credentials, never VITE_ variables.
# Register this exact callback URL in GitHub's OAuth App settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Local UI work only. Ignored when NODE_ENV=production.
DEV_BYPASS_AUTH=false

# Exact frontend origin for CORS and mutation requests
FRONTEND_URL=http://localhost:5173

# Local dev only
HOST=127.0.0.1
PORT=3000
