# PostgreSQL connection string (RDS)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://pomogit:yourpassword@your-rds-endpoint.rds.amazonaws.com:5432/pomogit

# Set to 'false' only for local dev without SSL
DATABASE_SSL=true

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for CORS (CloudFront domain or localhost)
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net

# Admin API protection secret
ADMIN_SECRET=

# First user to be seeded as admin on startup (must register first)
INITIAL_ADMIN_EMAIL=you@example.com

# Local dev only
PORT=3000
