{
  "name": "pomogit-backend",
  "version": "1.0.0",
  "description": "Backend for the application Pomogit, a commit-based organizing for github.",
  "keywords": [
    "pomodoro"
  ],
  "license": "ISC",
  "author": "Zack",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check:production": "node scripts/checkProduction.js",
    "db:init": "node scripts/database.js init",
    "db:workspace": "node scripts/database.js workspace",
    "db:github": "node scripts/database.js github",
    "db:projects": "node scripts/database.js projects",
    "db:auth": "node scripts/database.js auth",
    "db:auth-limits": "node scripts/database.js auth-limits",
    "db:migrate": "node scripts/database.js migrate",
    "db:cleanup-legacy": "node scripts/database.js cleanup-legacy",
    "admin:promote": "node scripts/promoteAdmin.js",
    "check": "node scripts/checkSyntax.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "better-auth": "1.7.10",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.13.3",
    "zod": "^3.23.8"
  }
}
