# Private deployment file, never committed. Keep local backend/.env separate.
# Neon direct PostgreSQL URL. Remove URL query parameters and verify TLS below.
DATABASE_URL=postgresql://pomogit_runtime:replace-with-private-runtime-password@your-neon-host/neondb
# Schema owner; used for backups and IAM-only migrations, never placed in API Lambda.
MIGRATION_DATABASE_URL=postgresql://owner:replace-with-private-owner-password@your-neon-host/neondb
DATABASE_SSL=true
NODE_ENV=production
DEV_BYPASS_AUTH=false
FRONTEND_URL=https://pomogit.example
API_URL=https://api.pomogit.example
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Stable random signing key; generate privately, never commit a real value.
BETTER_AUTH_SECRET=
