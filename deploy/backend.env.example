# Copy outside the release tree (for example /etc/pomogit/backend.env).
# Replace the domain and database credentials before use. Do not commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=https://pomogit.example
DEV_BYPASS_AUTH=false
SESSION_TTL_HOURS=168

# Loopback-only PostgreSQL. Remote databases require DATABASE_SSL=true.
# No URL query parameters: they can override node-postgres TLS settings.
DATABASE_URL=postgresql://pomogit:replace-with-private-password@127.0.0.1:5432/pomogit
DATABASE_SSL=false
DATABASE_CA_CERT=

# Set all three to enable GitHub sign-in; otherwise leave all three empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Stable random signing key; generate privately, never commit a real value.
BETTER_AUTH_SECRET=
