[Unit]
Description=Pomogit account API
After=network.target

[Service]
Type=simple
User=pomogit
Group=pomogit
WorkingDirectory=/srv/pomogit/current/backend
EnvironmentFile=/etc/pomogit/backend.env
ExecStartPre=/usr/bin/node scripts/checkProduction.js
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
